# duplicate of site/public/al-adrak-brochure.pdf (identical md5) — keep one copy
271022124050Aladrak_Main_Brochure_35th_yr_Low_Res*.pdf

# generated deliverable — rebuild with: node scripts-hse-doc.js
Al-Adrak-HSE-page.docx

# Source archive of awards/era photos (311MB) — prepared copies live under
# site/public/images/timeline. Anchored like the other archives above.
/photos-*/

# Staging folder for scripts/prep-group.mjs. Holds the raw logo renders and the
# two resort photographs pulled from mountainmist.in / summersand.in; the header
# of that script records where each file comes from. Prepared copies live under
# site/public/images/group and /hotels, same as the other archives above.
/site/scripts/.src-group/

# Staging folder for scripts/prep-hse.mjs — LibreOffice SVG renders of the IAS
# certificate PDFs from /Images/HSE (itself covered by /Images/ above).
/site/scripts/.src-hse/

# Staging for scripts/prep-portraits.mjs — the client-supplied studio
# originals (5-8 MB each). Only the cropped 500x600 / 1400x1750 derivatives
# belong in public/, which ships verbatim to the static export.
/site/scripts/.src-portraits/

# Untouched master of the corporate film. scripts/prep-story.mjs re-cuts it into
# public/videos/story.mp4; keeping both in git would double a 31MB asset.
/site/scripts/.src-story/

# scratch clips from the media prep scripts — each rmSyncs its own on success,
# but an interrupted render must not be committable
/site/scripts/.tmp-*/

# Staging for scripts/prep-life.mjs — the two phone frames of the Sunday
# briefing. Only the 16:10 tile and the podium card belong in public/.
/site/scripts/.src-life/

# Staging for scripts/prep-timeline.mjs — the as-supplied 1990 site photograph, before
# the man standing in it was cropped out. Only the 5:4 plate belongs in public/.
/site/scripts/.src-timeline/

# Staging for scripts/prep-it-facility.mjs — the client's data-centre photograph
# as supplied (a brochure crop with its caption box baked in). Only the 4:3 card
# tile belongs in public/.
/site/scripts/.src-facilities/

# Build artefacts packaged for upload to the host — 120MB of zip has no
# business in git, and `npm run build:php` recreates them in a minute.
/*.zip
